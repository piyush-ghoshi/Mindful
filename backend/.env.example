# ============================================================================
# Mindful Backend — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================================

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/mindful
DATABASE_USERNAME=mindful_user
DATABASE_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (256 bits) for HS256 signing
JWT_SECRET=

# ── Groq AI (MindBot) ────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Firebase ─────────────────────────────────────────────────────────────────
# Option A: Paste the FULL Firebase service account JSON (single line)
FIREBASE_CREDENTIALS_JSON=

# Option B: Path to a Firebase service account JSON file outside the repo
# FIREBASE_CREDENTIALS_PATH=/path/to/your/firebase-key.json

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ── Mail (optional — disabled by default) ─────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Redis (required for rate limiting) ────────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
